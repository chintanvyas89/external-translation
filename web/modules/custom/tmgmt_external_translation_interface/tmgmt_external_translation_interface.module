<?php

/**
 * @file
 * Protects editor corrections made through Drupal's normal interface
 * translation UI (/admin/config/regional/translate), the same way the
 * core module protects content edits.
 */

use Drupal\Core\Form\FormStateInterface;
use Drupal\tmgmt_external_translation\Translation\TranslationFieldContext;
use Drupal\tmgmt_external_translation\Translation\TranslationProvenanceManagerInterface;

/**
 * Implements hook_form_FORM_ID_alter() for locale_translate_edit_form.
 */
function tmgmt_external_translation_interface_form_locale_translate_edit_form_alter(array &$form, FormStateInterface $form_state, $form_id) {
  $form['#submit'][] = '_tmgmt_external_translation_interface_classify_submit';
}

/**
 * Runs after core's own submit handler has saved the strings, and
 * classifies each saved lid the same way the content module's entity-save
 * hook does: unchanged relative to our last recorded baseline is a no-op,
 * matching the last known provider output is an implicit approval,
 * anything else is an editor correction.
 */
function _tmgmt_external_translation_interface_classify_submit(array $form, FormStateInterface $form_state): void {
  $langcode = $form_state->getValue('langcode');
  $lids = array_keys((array) $form_state->getValue('strings'));
  if (!$lids || !$langcode) {
    return;
  }

  /** @var \Drupal\tmgmt_external_translation\Translation\TranslationProvenanceManagerInterface $provenanceManager */
  $provenanceManager = \Drupal::service('tmgmt_external_translation.provenance_manager');
  /** @var \Drupal\tmgmt_external_translation\Translation\TranslationHashManagerInterface $hashManager */
  $hashManager = \Drupal::service('tmgmt_external_translation.hash_manager');
  /** @var \Drupal\locale\StringStorageInterface $localeStorage */
  $localeStorage = \Drupal::service('locale.storage');

  foreach ($lids as $lid) {
    $translation = $localeStorage->findTranslation(['lid' => $lid, 'language' => $langcode]);
    if (!$translation || $translation->isNew()) {
      // Deleted, or never actually saved (empty submission) - nothing to
      // classify.
      continue;
    }
    $newValue = $translation->getString();
    $context = new TranslationFieldContext('interface_string', (string) $lid, 'en', $langcode, 'interface_string', (string) $lid, 'translation', 0, 'value');
    $record = $provenanceManager->getRecord($context);

    if (!$record) {
      $provenanceManager->recordEditorEdit($context, $newValue, TranslationProvenanceManagerInterface::ORIGIN_EDITOR);
      continue;
    }

    $newHash = $hashManager->hash($newValue);
    if ($newHash === $record['current_target_hash']) {
      continue;
    }
    if ($newHash === $record['provider_translation_hash']) {
      $provenanceManager->recordEditorApproval($context, $newValue);
    }
    else {
      $provenanceManager->recordEditorModification($context, $newValue);
    }
  }
}
